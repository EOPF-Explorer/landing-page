{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "outDir": "dist",
    "target": "esnext",
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom", "DOM.Iterable"]
  },
  "exclude": [
    "node_modules",
    "public",
    "**/dist/**",
    ".vitepress/cache",
    ".vitepress/config.js",
    ".vitepress/plugins"
  ],
  "include": [
    ".vitepress/**/*.js",
    ".vitepress/**/*.vue",
    ".vitepress/**/*.md",
    "**/*.md",
    "**/*.d.ts"
  ],
  "vueCompilerOptions": {
    "vitePressExtensions": [".md"]
  }
}
