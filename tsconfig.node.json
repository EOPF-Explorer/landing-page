{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    ".vitepress/config.js",
    ".vitepress/plugins/**/*.js",
    ".vitepress/plugins/**/*.d.ts",
    "content/**/*.data.js"
  ]
}
